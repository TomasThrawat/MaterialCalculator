<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="24dp"
    android:paddingBottom="12dp"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingHorizontal="8dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:gravity="end"
            android:maxLines="2"
            android:ellipsize="start"
            android:text="0"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start"
            android:text="0"
            android:textColor="?attr/colorOnSurface"
            android:textSize="54sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_clear"
                style="@style/CalculatorKey.Action"
                android:text="AC" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_backspace"
                style="@style/CalculatorKey.Action"
                android:text="⌫"
                android:contentDescription="@string/backspace" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_percent"
                style="@style/CalculatorKey.Action"
                android:text="%" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_divide"
                style="@style/CalculatorKey.Operator"
                android:text="÷"
                android:contentDescription="@string/divide" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_7"
                style="@style/CalculatorKey.Number"
                android:text="7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_8"
                style="@style/CalculatorKey.Number"
                android:text="8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_9"
                style="@style/CalculatorKey.Number"
                android:text="9" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_multiply"
                style="@style/CalculatorKey.Operator"
                android:text="×"
                android:contentDescription="@string/multiply" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_4"
                style="@style/CalculatorKey.Number"
                android:text="4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_5"
                style="@style/CalculatorKey.Number"
                android:text="5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_6"
                style="@style/CalculatorKey.Number"
                android:text="6" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_subtract"
                style="@style/CalculatorKey.Operator"
                android:text="−"
                android:contentDescription="@string/subtract" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_1"
                style="@style/CalculatorKey.Number"
                android:text="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_2"
                style="@style/CalculatorKey.Number"
                android:text="2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_3"
                style="@style/CalculatorKey.Number"
                android:text="3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_add"
                style="@style/CalculatorKey.Operator"
                android:text="+"
                android:contentDescription="@string/add" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_sign"
                style="@style/CalculatorKey.Action"
                android:text="±"
                android:contentDescription="@string/sign" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_0"
                style="@style/CalculatorKey.Number"
                android:text="0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_decimal"
                style="@style/CalculatorKey.Number"
                android:text="." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_equals"
                style="@style/CalculatorKey.Equals"
                android:text="="
                android:contentDescription="@string/equals" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
